<Window x:Class="shoppinglist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr:namespace:shoppinglist"
        mc:Ignorable="d"
        Title="My Shopping List" Height="450" Width="400">
    <TabControl>
        <!-- Shopping List Tab -->
        <TabItem Header="Shopping List">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MY SHOPPING LIST" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ItemNameTextBox" Margin="0,0,5,0" KeyDown="ItemNameTextBox_KeyDown" VerticalContentAlignment="Center"/>
                    <Button x:Name="AddButton" Content="Add Item" Padding="10,5" Grid.Column="1" Click="AddButton_Click"/>
                </Grid>

                <ListBox x:Name="ShoppingListBox" Grid.Row="2" Margin="0,0,0,10" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsPurchased, Mode=TwoWay}" Content="{Binding Name}" Checked="CheckBox_Checked" Unchecked="CheckBox_Checked" VerticalAlignment="Center"/>
                                <Button Content="Remove" Grid.Column="1" Margin="10,0,0,0" Padding="5,0" Tag="{Binding}" Click="RemoveButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3">
                    <TextBlock x:Name="StatusTextBlock" Text="0 items" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button x:Name="ClearPurchasedButton" Content="Clear Purchased" Padding="10,5" HorizontalAlignment="Right" Click="ClearPurchasedButton_Click"/>
                </Grid>
            </Grid>
        </TabItem>

        <!-- Catalog Tab -->
        <TabItem Header="Catalog">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MY ITEMS" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CatalogItemNameTextBox" Margin="0,0,5,5" KeyDown="CatalogItemNameTextBox_KeyDown" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="0" />

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,0,5,0">
                        <Button x:Name="UploadImageButton" Content="Upload Image" Padding="5" Click="UploadImageButton_Click" Height="25"/>
                        <Button x:Name="SearchImageButton" Content="Search Internet" Padding="5" Click="SearchImageButton_Click" Height="25" Margin="5,0,0,0"/>
                        <TextBlock x:Name="SelectedImagePathTextBlock" Text="No image selected" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>

                    <Button x:Name="AddCatalogItemButton" Content="Add to Catalog" Padding="10,5" Grid.RowSpan="2" Grid.Column="1" Click="AddCatalogItemButton_Click" />
                </Grid>

                <ListBox x:Name="CatalogListBox" Grid.Row="2" Margin="0,0,0,10" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Item content with highlight background -->
                                <Border Grid.Row="0" Padding="10" BorderBrush="{x:Null}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#E8F0FE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding ImagePath}" Width="40" Height="40" Margin="0,0,10,0" Stretch="UniformToFill" VerticalAlignment="Center" Grid.Column="0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TimesPurchased, StringFormat='{}Purchased: {0} times'}" FontSize="10" Foreground="Gray" />
                                            <TextBlock Text="{Binding LastPurchased, StringFormat='{}Last purchased: {0:MMM dd}', TargetNullValue='Last purchased: Never'}" FontSize="10" Foreground="Gray" />
                                        </StackPanel>

                                        <Button Content="Add to List" Grid.Column="2" Margin="10,0,0,0" Padding="5,0" Tag="{Binding}" Click="AddFromCatalogButton_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Row 1: Remove row — hidden until item is selected -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="Remove" Padding="5,0" Tag="{Binding}" Click="RemoveCatalogItem_Click" Foreground="Red"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
